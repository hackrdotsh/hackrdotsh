{
  "name": "hackr.sh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "convex deploy --yes && vinext build",
    "dev": "vinext dev --port 3002",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "biome check",
    "format": "biome format --write",
    "preview": "vinext build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "convex deploy --yes && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@better-auth/passkey": "1.6.33",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@convex-dev/better-auth": "0.12.6",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.19",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "next": "16.2.12",
      "hono": "4.13.11",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "postcss": "8.5.25",
      "dompurify": "3.4.17",
      "brace-expansion": "5.0.12",
      "fast-uri@^3": "3.1.9",
      "sharp": "0.35.5",
      "postcss-selector-parser@^6": "6.1.5",
      "postcss-selector-parser@^7": "7.1.7",
      "fflate@^0.7": "0.7.5",
      "fflate@^0.8": "0.8.3",
      "image-size": "2.0.4",
      "source-map-js": "1.2.2",
      "nanoid@^3": "3.3.18"
    },
    "patchedDependencies": {
      "@convex-dev/better-auth@0.12.6": "patches/@convex-dev__better-auth@0.12.6.patch"
    }
